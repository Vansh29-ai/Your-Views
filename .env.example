# YOUR VIEWS — backend environment
# Copy to .env (project root or backend/) and adjust. All vars are optional.

# development | test | production
YV_ENVIRONMENT=development
YV_DEBUG=false

# Storage. SQLite works out of the box; point at PostgreSQL in production.
YV_DATABASE_URL=sqlite:///./data/yourviews.db
# YV_DATABASE_URL=postgresql+psycopg://yourviews:yourviews@localhost:5432/yourviews

# Comma-separated origins allowed to call the API (the Vite dev server is included by default).
YV_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Ingestion
YV_INGESTION_INTERVAL_MINUTES=30
YV_ENABLE_SCHEDULER=true
YV_INGEST_ON_STARTUP=true
YV_MAX_ARTICLES_PER_FEED=40
YV_REQUEST_TIMEOUT_SECONDS=20
YV_REQUEST_RETRIES=2
YV_USER_AGENT=Mozilla/5.0 (compatible; YourViews/1.0; +local news aggregation)

# NLP
YV_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
YV_ALLOW_EMBEDDING_FALLBACK=true

# Event matching (calibrated for all-MiniLM-L6-v2 on live English news coverage)
YV_STRONG_SIMILARITY=0.70
YV_WEAK_SIMILARITY=0.58
YV_CANDIDATE_WINDOW_HOURS=96
YV_CLUSTER_EPS=0.38
YV_CLUSTER_MIN_SAMPLES=2

# Optional: protect write/admin endpoints with an API key
YV_ENABLE_INGEST_API_KEY=false
YV_INGEST_API_KEY=

# Logging
YV_LOG_LEVEL=INFO
